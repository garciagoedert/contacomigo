{
    "hosting": {
        "public": ".",
        "cleanUrls": true,
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "functions/**",
            "*.md",
            ".env.example"
        ],
        "rewrites": [
            {
                "source": "/api/getAdminData",
                "function": "getAdminData"
            },
            {
                "source": "/api/subscribeToNewsletter",
                "function": "subscribeToNewsletter"
            },
            {
                "source": "/api/getNewsletterPosts",
                "function": "getNewsletterPosts"
            },
            {
                "source": "/artigos/**",
                "destination": "/post_viewer.html"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        }
    ],
    "emulators": {
        "hosting": {
            "port": 8000
        },
        "ui": {
            "enabled": true
        }
    }
}