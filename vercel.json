{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/artigos",
            "destination": "/content_list"
        },
        {
            "source": "/artigos/:slug",
            "destination": "/post_viewer"
        }
    ],
    "headers": [
        {
            "source": "/((?!api/).*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}